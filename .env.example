# Claude Context 环境变量示例（云端向量索引模式）
#
# 复制为 ~/.context/.env 作为全局配置：cp .env.example ~/.context/.env
# 注意：不要放在代码仓库目录（会与项目自身 env 冲突）。
#
# 架构：本地【不做】任何向量索引写入。向量统一由云端 git-index-service 按
# "仓库:保护分支" 预先索引到 Milvus；本地 MCP 只做 ①查询向量化 ②直连云端
# Milvus 只读检索 ③本地图索引(SQLite)。通过 link 工具把当前仓库绑定到云端索引。

# =============================================================================
# 本地 MCP（开发者机器）
# =============================================================================

# Embedding provider：本地把 search 的 query 转成向量用（不在本地落向量库）。
# OpenAI / VoyageAI / Gemini / Ollama。团队默认 Ollama（模型也在云端）。
EMBEDDING_PROVIDER=Ollama
EMBEDDING_MODEL=nomic-embed-text
# Ollama 服务地址（团队云端）
OLLAMA_HOST=http://10.50.4.149:11435
EMBEDDING_DIMENSION=768

# 云端 Milvus（只读检索）
MILVUS_ADDRESS=10.50.4.149:19530
# MILVUS_TOKEN=

# 云端 git-index-service 管理面（link 时列出可链接的保护分支）
GIT_INDEX_SERVICE_URL=http://10.50.4.149:8795

# 混合检索（dense 向量 + BM25 sparse，RRF 融合）。团队索引均按 hybrid 建立。
HYBRID_MODE=true

# --- search 输出调优（可选）---
# SEARCH_DEFAULT_LIMIT=10        # 每次返回最大条数
# SEARCH_THRESHOLD=0.4           # 相对分数截断（topScore*threshold 以上保留）
# SEARCH_SNIPPET_MAX_CHARS=4000  # 单条片段字符上限
# SEARCH_TOTAL_MAX_CHARS=20000   # 整个响应的片段预算，按命中数均分（单条下限 600）
# SEARCH_SCORE_RATIO=0           # 尾部截断（0=禁用）
# SEARCH_TEST_PENALTY=0.55       # 测试文件分数系数（search 传 tests:true 时置 0）
# SEARCH_DOC_PENALTY=0.5         # 文档/markdown 分数系数（search 传 docs:true 时置 0）

# --- 本地图索引调优（可选）---
# CODEGRAPH_PARSE_WORKERS=       # 解析 worker 数，默认 cores-2；< 120 文件不启池
# CODEGRAPH_PARSE_TIMEOUT_MS=10000  # 单文件解析超时，超时跳过该文件

# 各 provider 的 API Key（仅当 EMBEDDING_PROVIDER 用对应云端服务时需要）
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# VOYAGEAI_API_KEY=
# GEMINI_API_KEY=
# GEMINI_BASE_URL=
# OPENROUTER_API_KEY=

# =============================================================================
# 云端 git-index-service（服务器，非本地）
# =============================================================================
# 定时从 GitLab 拉取各仓库的 main + 保护分支，增量索引到 Milvus。
# 以下变量只在服务器部署该服务时配置，本地开发者无需设置。

# 仓库来源：'config'（GIT_INDEX_REPOS）或 'gitlab'（API 发现）
# GIT_INDEX_SOURCE=config
# 仓库列表：branch 为 main；protectedBranches 为额外保护分支（各自独立 collection）
# GIT_INDEX_REPOS=[{"name":"acme/app","url":"https://gitlab.example.com/acme/app.git","branch":"main","protectedBranches":["release/1.0"],"token":"glpat-xxx"}]
# 本地镜像工作目录
# GIT_INDEX_WORKDIR=/var/lib/claude-context/repos
# 调度：每日某小时(0-23) 或固定间隔 ms（每日优先）
# GIT_INDEX_DAILY_HOUR=3
# GIT_INDEX_INTERVAL_MS=86400000
# 启动即跑一轮（默认 true）
# GIT_INDEX_RUN_ON_START=true
# HTTP 控制口（容器内，默认 8790）
# GIT_INDEX_HTTP_PORT=8790

# --- 服务端写入调优（仅服务端有效）---
# 同时索引几个仓库。由 embedding 吞吐决定而非核数：实测本栈 ollama 的饱和点是 6
# （1/3/6/8/12 流 → 27/75/136/140/142 embed/s）。换机器用
# `node benchmarks/embed-throughput.mjs` 重新测，别照抄。
# GIT_INDEX_CONCURRENCY=6
# 每攒够多少 chunk 就 flush 一次向量化 —— 它同时是单 worker 内存的主导上界
# （实测单 worker 峰值 RSS ~1 GiB，其中 956 MiB 在 tree-sitter 堆外）。
# EMBEDDING_BATCH_SIZE=100       # 服务端批量 embedding
# EMBEDDING_CACHE_ENABLED=true   # 内容哈希向量缓存（跨分支/开发者复用）
# GIT_INCREMENTAL_ENABLED=true   # git diff 增量索引
# GIT_DELTA_MAX_FILES=2000       # 增量变更文件数上限，超过回退全量
